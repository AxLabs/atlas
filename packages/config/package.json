{
  "name": "@thedanielmark/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared configuration for linting, formatting, and TypeScript",
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./typescript": "./tsconfig.base.json",
    "./typescript/nextjs": "./tsconfig.nextjs.json",
    "./typescript/react-library": "./tsconfig.react-library.json",
    "./prettier": "./.prettierrc.json",
    "./jest": "./jest.config.js"
  },
  "files": [
    "eslint.config.mjs",
    "tsconfig.*.json",
    ".prettierrc.json",
    "jest.config.js"
  ],
  "scripts": {
    "lint": "echo 'No lint script for config package'",
    "typecheck": "echo 'No typecheck script for config package'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
