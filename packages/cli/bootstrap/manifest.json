{
  "schemaVersion": 1,
  "generatedAtInit": [
    {
      "destination": "atlas.config.json",
      "reason": "Records project identity, capability defaults, and platform.baseline checksums for this consumer."
    },
    {
      "destination": "package.json",
      "reason": "Root workspace name, scripts, and dependency graph are consumer-specific; the Atlas monorepo package.json is maintainer-only."
    },
    {
      "destination": "pnpm-lock.yaml",
      "reason": "Left absent until the consumer runs pnpm install. Atlas does not copy or fabricate a maintainer lockfile."
    },
    {
      "destination": "README.md",
      "reason": "Consumer quickstart is generated when atlas init materializes a project; the repository README is clone-first onboarding."
    },
    {
      "destination": "jest.config.js",
      "reason": "Root Jest project list currently includes apps/reference and must be rewritten for the generated workspace."
    },
    {
      "destination": "apps/web/.env.local",
      "reason": "User-specific secrets are never packaged. atlas init leaves .env.local absent unless --env copy is requested, in which case .env.example is copied."
    }
  ],
  "entries": [
    {
      "source": "apps/web",
      "destination": "apps/web"
    },
    {
      "source": "packages/ui",
      "destination": "packages/ui",
      "exclude": [
        ".storybook/**",
        "visual-tests/**",
        ".husky/**",
        "scripts/**",
