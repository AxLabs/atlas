{
  "name": "@atlas/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Atlas command-line interface for project contract and bootstrap workflows",
  "bin": {
    "atlas": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dependency-validation": "./dist/doctor/dependency-imports.js",
    "./workspace-membership": "./dist/doctor/workspace-membership.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf .turbo node_modules coverage dist"
  },
  "dependencies": {
    "@atlas/project": "workspace:*",
    "minimatch": "10.2.5",
    "typescript": "5.7.2",
    "yaml": "2.5.1"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "ts-jest": "29.2.5",
    "typescript-eslint": "^8.50.0"
  }
}
