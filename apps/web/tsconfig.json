{
  "extends": "../../packages/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "baseUrl": "./",
    "skipLibCheck": true,
    "types": ["jest", "@testing-library/jest-dom"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@/components/ui/*": ["../../packages/ui/src/components/ui/*"],
      "@/components/*": ["../../packages/ui/src/components/*", "./src/components/*"],
      "@/lib/utils": ["../../packages/ui/src/lib/utils.ts"],
      "@/lib/*": ["../../packages/ui/src/lib/*", "./src/lib/*"],
      "@/hooks/*": ["../../packages/ui/src/hooks/*", "./src/hooks/*"],
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry-instrumentation.enabled.ts",
    "sentry-instrumentation.noop.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules"]
}
