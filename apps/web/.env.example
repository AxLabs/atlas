# Environment variables
# Copy this file to .env.local and fill in the values

# Client-side environment variables (exposed to browser)
# These are prefixed with NEXT_PUBLIC_ and bundled into the client JavaScript
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Server-side environment variables (never exposed to browser)
# These are only accessible in API routes, server components, and middleware
DATABASE_URL=postgresql://user:password@localhost:5432/atlas
